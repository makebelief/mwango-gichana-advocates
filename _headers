/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://www.google.com https://maps.gstatic.com https://maps.googleapis.com; media-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src https://www.google.com https://maps.google.com; connect-src 'self'; font-src 'self' data:; form-action 'self' mailto:; base-uri 'self'; frame-ancestors 'none'
